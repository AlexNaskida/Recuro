{
  "name": "recuro-sdk",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "sdk",
    "client/apps/*",
    "client/landing"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace merchant-dashboard dev\" \"yarn workspace user-demo dev\" \"yarn workspace recuro-landing dev\"",
    "dev:merchant": "yarn workspace merchant-dashboard dev",
    "dev:user": "yarn workspace user-demo dev",
    "dev:landing": "yarn workspace recuro-landing dev",
    "build": "concurrently \"yarn workspace merchant-dashboard build\" \"yarn workspace user-demo build\"",
    "build:sdk": "yarn --cwd sdk build",
    "type-check": "yarn workspaces run type-check",
    "lint": "yarn workspaces run lint",
    "test": "anchor test",
    "test:devnet": "anchor test --provider.cluster devnet",
    "anchor:build": "anchor build",
    "anchor:deploy": "anchor deploy",
    "anchor:idl": "cp target/idl/subscription.json sdk/src/idl.json && echo 'IDL synced'"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "chai": "^4.3.11",
    "concurrently": "^9.2.1",
    "mocha": "^11.3.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.0",
    "@privy-io/react-auth": "^3.22.2",
    "@qvac/cli": "^0.2.4",
    "@qvac/sdk": "^0.10.0",
    "@solana-program/memo": "^0.11.0",
    "bare-abort-controller": "^1.1.1",
    "bare-buffer": "^3.6.0",
    "bare-crypto": "^1.13.6",
    "bare-dns": "^2.1.4",
    "bare-fetch": "^3.0.1",
    "bare-fs": "^4.7.1",
    "bare-http1": "^4.5.6",
    "bare-https": "^3.0.0",
    "bare-link": "^3.2.1",
    "bare-net": "^2.3.1",
    "bare-os": "^3.9.1",
    "bare-path": "^3.0.0",
    "bare-process": "^4.4.1",
    "bare-rpc": "^1.3.0",
    "bare-runtime": "^1.28.4",
    "bare-stream": "^2.13.1",
    "bare-subprocess": "^6.0.0",
    "bare-zlib": "^1.3.3",
    "compact-encoding": "^3.0.0",
    "corestore": "^7.9.2",
    "events": "^3.3.0",
    "hyperdb": "^6.6.3",
    "hyperdrive": "^13.3.2",
    "hyperswarm": "^4.17.0",
    "llm-splitter": "^0.2.0",
    "next": "^9.3.3",
    "pear-pipe": "^1.0.6",
    "tar-stream": "^3.2.0"
  }
}
